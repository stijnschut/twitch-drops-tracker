# Copy this file to ".env" and fill it in. ".env" is git-ignored.

# Required: the Discord webhook URL notifications are sent to.
DISCORD_WEBHOOK_URL=

# Optional: bot display name (kept anonymous by default).
DISCORD_WEBHOOK_USERNAME=Twitch Drops Tracker

# Optional: avatar image URL for the webhook bot.
DISCORD_WEBHOOK_AVATAR_URL=

# IANA timezone name used to format start/end times in Discord embeds.
#   UTC, Europe/Amsterdam, Europe/Berlin, Europe/London,
#   America/New_York, Asia/Shanghai, Asia/Kolkata
TIMEZONE=UTC

# Reminder thresholds, in hours before the start/end of a campaign.
START_SOON_HOURS=24
END_SOON_HOURS=24

# Send a fresh notification if an existing campaign's reward list changes.
NOTIFY_ON_CHANGES=true

# Send a "scan failed" alert if the API is down (once per cooldown).
ALERT_ON_FAILURE=false
FAILURE_COOLDOWN_SECONDS=43200

# Sunkwi API settings. Usually no need to change these.
API_BASE_URL=https://twitch-drops-api.sunkwi.com
API_TIMEOUT_SECONDS=30
